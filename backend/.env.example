# Backend configuration
PORT=4000
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# How often (ms) to push a new congestion snapshot over the socket
TICK_MS=2000
# Directory for the file-backed store (watch areas + severity history).
# Defaults to backend/data-store when unset.
# DATA_DIR=./data-store

# --- Web Push (Phase 4) ---------------------------------------------------
# VAPID keys for Web Push. Leave unset to auto-generate + persist them in the
# store on first boot (fully free, no third-party service). Set both to pin
# your own, e.g. from `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact subject sent to push services (mailto: or https: URL).
# VAPID_SUBJECT=mailto:admin@traffic-radar.local
# Per-device cooldown (ms) between jam pushes. Defaults to 60000.
# PUSH_COOLDOWN_MS=60000

